# ── データベース ─────────────────────────────────────────────────
POSTGRES_DB=houoevents
POSTGRES_USER=houo
POSTGRES_PASSWORD=your-db-password

# ── バックエンド ─────────────────────────────────────────────────
MEMBER_CODE=メンバーに共有するコード
ADMIN_CODE=管理者だけが知るコード

JWT_SECRET=ランダムな長い文字列（python -c "import secrets; print(secrets.token_hex(32))" で生成）

# 本番は Vercel の URL に変更
CORS_ORIGINS=http://localhost:3000

# ── フロントエンド ────────────────────────────────────────────────
# 本番は Render/Railway の URL に変更
NEXT_PUBLIC_API_URL=http://localhost:8000
