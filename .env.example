# ── ローカル開発用 Docker ──────────────────────────────────────────
POSTGRES_DB=houoevents
POSTGRES_USER=houo
POSTGRES_PASSWORD=your-db-password

# ── バックエンド（Render）────────────────────────────────────────
# Neon の接続文字列をそのままコピー
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

MEMBER_CODE=メンバーに共有するコード
ADMIN_CODE=管理者だけが知るコード

# python -c "import secrets; print(secrets.token_hex(32))" で生成
JWT_SECRET=ランダムな長い文字列

# Vercel のデプロイURL（例: https://houo-attend.vercel.app）
CORS_ORIGINS=https://your-app.vercel.app

# ── フロントエンド（Vercel）──────────────────────────────────────
# Render のバックエンドURL（例: https://houo-attend-backend.onrender.com）
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
